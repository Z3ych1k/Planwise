# Template only. Copy to .env.cloudflare on the NAS; never commit credentials.
PLANWISE_PUBLIC_ORIGIN=https://planner.example.com
PLANWISE_BUILD_REF=feature/nas-cloudflare-oop
PLANWISE_TUNNEL_TOKEN_FILE=./.secrets/cloudflare-tunnel-token
# Change all three together if this subnet overlaps another Docker/VPN network.
PLANWISE_TUNNEL_SUBNET=172.30.77.0/29
PLANWISE_ORIGIN_IP=172.30.77.2
PLANWISE_CONNECTOR_IP=172.30.77.3
